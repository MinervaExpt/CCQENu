{
    "tag": "October 8, 2026 - this works on scaled input",
    "InputFiles": {
        "QElike": "${FITTED}_scaled.root"
    },
    "Target": "Nucleons",
    "ZeroBinFixer": 0,
    "POTScale": 0,
    "Samples": [
        "QElike"
    ],
    "Categories": [
        "bkgsub",
        "qelike"
    ],
    "Data_Cat": "bkgsub",
    "Signal_Cat": "qelike",
    "Background_Cat": [],
    "Migration": "response",
    "Data_Type": "scaled",  //could be scaled instead
    "UnTunedSignal_Type": "reconstructed",
    "Signal_Type": "scaled", //could be scaled instead
    "Background_Type": "scaled",
    "Selected_Type": "selected_truth",
    "Truth_Type": "all_truth",
    "UnTunedTruth_Type": "all_truth",
    "Migration_Type": "response_migration",
    "data_types1D": {
        "bkgsub": [
            "reconstructed","fitted","scaled"
        ],
        "qelike": [
            "fitted",
            "scaled",
            "reconstructed",
            "selected_truth",
            "all_truth",
            "response_truth",
            "response_reconstructed",
            "response_migration"
        ]
    },
    "data_types2D": {
        "bkgsub": [],
        "qelike": [
            "response_migration"
        ]
    },
    "Variables": [ 
         "ptmu",
         "pzmu",
         "Q2QE",
         "EnuCCQE"
         //"EnuCCQE"
    ],
    "Scales": {
        "ptmu": 3,
        "Q2QE": 3,
        "pzmu": 0,
        "EnuCCQE": 0
    },
    "FluxNorm": {
        "ptmu": false, "Q2QE": false, "pzmu": false, "EnuCCQE": true
    },
    "PixDir": "./pix",
    "LogMinimum": 0.1,
    "Stages": {
        "Unfold": {
            "In": "scaled",
            "Out": "unfolded"
        },
        "Efficiency": {
            "In": "unfolded",
            "Out": "effcorr"
        },
        "Flux": {
            "In": "effcorr",
            "Out": "sigma"
        }
    },
    "Iterations": 5,
    "PDFALL": 1,
    "Formats": [
        "png",
        "C"
    ],
    "AreaNorm": 1,
    "FractionalUncertainty": 1
