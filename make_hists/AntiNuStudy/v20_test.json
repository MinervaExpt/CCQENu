{
  "version":20, // use Noah's cuts for validation 
  "mcIn":"${CCQEMAT}/playlists/${DATALOC}_p6/minervame${MYPLAYLIST}_MC.txt",
  "dataIn":"${CCQEMAT}/playlists/${DATALOC}_p6/minervame${MYPLAYLIST}_Data.txt", // hack for type plot of resolution
  "prescale":999,
  "playlist":"minervame${MYPLAYLIST}",
  "DoResolution":1,
  "MinervaModel":"${MYMODEL}", // set this as an environmental to MnvTunev1 or MnvTunev2
  "recoName":"MasterAnaDev", // change if running on MAT tuples
  "tunedmc":"untuned", // uses the tunes if available
  "closure":0, // set to 1 if you want to do closure test, otherwise 0
  "scalefileIn":"${CCQEMAT}/data/FullSample_${MYMODEL}_Q2QErecoil.root", // location of anti-nu background tuning
  "TuneCategories":["qelike","neutralpion",
            "chargedpion",
            "other"], // categories that have tunes
  "pdg":-14, // I'm anti-neutrino
  "cutsFile":"${CCQEMAT}/AntiNuStudy/AntiNuCuts_v20.json", // describe the cuts, choose them in samples
  "varsFile":"${CCQEMAT}/AntiNuStudy/Variables_v20.json", // describe the variables, choose them below
  "samplesFile":"${CCQEMAT}/AntiNuStudy/AntiNuSamples_v20.json",  // describe the samples, cuts are chosen here
  "runsamples":["${MYSAMPLE}"], // chose which samples to run can provide a list or chose 1 using the batch
  "outRoot":"${MYPLAYLIST}_${MYMODEL}_${MYSAMPLE}", // name for output files
  "AnalyzeVariables":["Q2QE","pzmu","ptmu","ZVertex","EnuCCQE","recoil"], // choose the 1D variables
  "Analyze2DVariables":[], // choose 2D variables, 1D variables must be chosen
  "signal":{"QElike":"qelike","Background":"qelike","QElikeNP":"qelike_np","QElikeALLAngles":"qelike_np"}, // used in analysis to define signal/background, key is the sample, value is what category is signal_tag
  "background":{"QElike":"qelikenot","Background":"qelikenot","QElikeNP":"qelikenot_np","QElikeALLAngles":"qelikenot_np"},
  "data":{"QElike":"data","Background":"data","QElikeNP":"data","QElikeALLAngles":"data"},
  // turn on/off systematics
  "responseSystematicsVersion":"2024",
  "systematics": [
    "Flux",
    "MuonMINOS",
    "MuonResolution",
    "MINOSEfficiency",
    "MuonMinerva"
    // "Angle",
    // "GENIE",
    // "GenieRvx1pi",
    // "RPA",
    // "2p2h",
    // "geant4",
    // "response"
  ],
  "fluxUniverses": 2, // # of flux universes set low to run fast!
  "NuEConstraint": 1, // apply constraints to flux
  "Geant4NeutronCV": 1, // set true by default docdb 28556
  "Geant4Elastics": 1 // set to true by default
}
